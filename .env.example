# ============================================================
# EduAgent 环境变量模板
# 使用方法：cp .env.example .env.local  然后填入真实值
# .env.local 已被 .gitignore 排除，不会进入版本库
# ============================================================

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent
DB_PASSWORD=change_me

# ── Milvus 向量库 ──
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ── 大模型（DeepSeek，兼容 OpenAI 协议）──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-chat

# ── 本地模型权重路径（相对项目根目录）──
RERANKER_MODEL_PATH=./backend/models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./backend/models/classifier/all-MiniLM-L6-v2
BGE_M3_MODEL_PATH=./backend/models/embedding/bge-m3

# ── JWT 认证 ──
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 联网搜索（可选，留空则用免费的 DuckDuckGo）──
TAVILY_API_KEY=
# 博查搜索（可选，https://open.bochaai.com/）
BOCHA_API_KEY=

# ── 应用基础配置 ──
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# ── Milvus 依赖的 MinIO（docker-compose 使用）──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
